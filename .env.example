# OpenShort.link Environment Configuration
PORT=3000
ENVIRONMENT=development
LOG_LEVEL=info

# Security: First user setup token (REQUIRED for first user creation via /dashboard/setup)
SETUP_TOKEN=openshortlink-setup-token-secret-2025

# Optional: Auto-create first user automatically at boot if set
FIRST_USER_USERNAME=admin
FIRST_USER_PASSWORD=ChangeMe123!
FIRST_USER_EMAIL=admin@urlz.eu.org

# Cloudflare API Credentials (for remote deployment and Analytics Engine querying)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Link and cache settings
CACHE_TTL=604800
MAX_LINKS_PER_DOMAIN=10000
